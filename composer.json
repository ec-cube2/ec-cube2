    "require-dev": {
        "phpunit/phpunit": "^4.8"
    },
    "suggest": {
        "ext-curl": "",
        "ext-hash": "",
        "ext-json": "",
        "ext-mcrypt": "",
        "ext-mysql": "",
        "ext-openssl": "",
        "ext-pgsql": "",
        "ext-xml": "",
        "ext-zip": ""
    },
    "config": {
        "sort-packages": true
    },
    "include-path": [
        "data/module/"
    ]
}
