{
    "name": "ec-cube2/ec-cube2",
    "description": "EC-CUBE",
    "homepage": "https://www.ec-cube.net/",
    "type": "project",
    "license": [
        "GPL-2.0",
        "proprietary"
    ],
    "support": {
        "issues": "https://github.com/EC-CUBE/ec-cube2/issues",
        "source": "https://github.com/EC-CUBE/ec-cube2"
    },
    "require": {
        "php": "^5.2",
        "ext-ctype": "*",
        "ext-gd": "*",
        "ext-mbstring": "*",
        "ext-session": "*",
        "ext-zlib": "*"
